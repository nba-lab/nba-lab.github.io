{
  "id": "/",
  "name": "NBA LAB · Props y estadísticas NBA",
  "short_name": "NBA LAB",
  "description": "Estadísticas NBA partido a partido, % de aciertos por línea, local/visitante y rivales. Se actualiza cada mañana.",
